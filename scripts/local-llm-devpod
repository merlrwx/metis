#!/usr/bin/env bash
# Invoked inside the existing Metis DevPod by scripts/local-llm.
set -euo pipefail
DOCKER_CONFIG="$(mktemp -d)"
export DOCKER_CONFIG
trap 'rm -rf "$DOCKER_CONFIG"' EXIT
export LOCAL_LLM_MODEL="${LOCAL_LLM_MODEL:-metis-qwen25:3b}"
compose=(docker compose -f compose.yaml -f compose.semantic.yaml -f compose.local-llm.yaml)
case "${METIS_LOCAL_GPU:-auto}" in
  auto)
    if [[ -d /dev/dri && -c /dev/kfd ]]; then
      compose+=(-f compose.local-llm-gpu.yaml)
    else
      echo 'AMD devices unavailable in DevPod; local chat will use CPU.'
    fi
    ;;
  off) ;;
  amd) compose+=(-f compose.local-llm-gpu.yaml) ;;
  *) echo 'METIS_LOCAL_GPU must be auto, amd or off' >&2; exit 1 ;;
esac
mise exec -- "${compose[@]}" up -d --wait --wait-timeout 180 llm
if [[ "$LOCAL_LLM_MODEL" == metis-qwen25:3b ]]; then
  if ! mise exec -- "${compose[@]}" exec -T llm ollama show qwen2.5:3b >/dev/null 2>&1; then
    mise exec -- "${compose[@]}" exec -T llm ollama pull qwen2.5:3b
  fi
  mise exec -- "${compose[@]}" cp scripts/Modelfile.local llm:/tmp/Metis.Modelfile
  mise exec -- "${compose[@]}" exec -T llm ollama create "$LOCAL_LLM_MODEL" -f /tmp/Metis.Modelfile
elif ! mise exec -- "${compose[@]}" exec -T llm ollama show "$LOCAL_LLM_MODEL" >/dev/null 2>&1; then
  mise exec -- "${compose[@]}" exec -T llm ollama pull "$LOCAL_LLM_MODEL"
fi
mise exec -- "${compose[@]}" build embeddings
mise exec -- "${compose[@]}" run --rm embeddings /app/.venv/bin/metis-download-embeddings
mise exec -- "${compose[@]}" up --build -d --wait --wait-timeout 180
mise exec -- "${compose[@]}" exec -T backend /app/.venv/bin/metis-check-embeddings
# Warm the real local model and report actual GPU placement, not device availability.
mise exec -- "${compose[@]}" exec -T backend /app/.venv/bin/python - <<'PY'
import json
import os
import urllib.request

assert os.environ["GPTMOCK_BASE_URL"] == "http://llm:11434/v1"
model = os.environ["GPTMOCK_MODEL"]
request = urllib.request.Request(
    "http://llm:11434/api/generate",
    data=json.dumps({"model": model, "stream": False}).encode(),
    headers={"Content-Type": "application/json"},
)
with urllib.request.urlopen(request, timeout=120) as response:
    result = json.load(response)
    assert result["model"] == model and result["done"]
with urllib.request.urlopen("http://llm:11434/api/ps", timeout=10) as response:
    loaded = next(row for row in json.load(response)["models"] if row["name"] == model)
print(f"Local chat: {model}; GPU bytes: {loaded['size_vram']}; context: {loaded['context_length']}")
PY
