#!/usr/bin/env bash
# Backend tests against a disposable PostgreSQL; never touches your Compose data.
set -euo pipefail
cd "$(dirname "$0")/.."
# shellcheck source=scripts/lib-throwaway-services.sh
source scripts/lib-throwaway-services.sh
start_throwaway_postgres
unset REDIS_URL
mise exec -- uv run --locked --project src/backend alembic -c src/backend/alembic.ini upgrade head
mise exec -- uv run --locked --project src/backend alembic -c src/backend/alembic.ini check
mise exec -- uv run --locked --project src/backend pytest src/backend/tests --cov=backend --cov-report=term-missing --cov-fail-under=80
