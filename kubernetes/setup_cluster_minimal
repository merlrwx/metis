#!/usr/bin/env bash
set -euo pipefail

CLUSTER_NAME="metis-minimal"

for dependency in k3d kubectl; do
  if ! command -v "$dependency" >/dev/null 2>&1; then
    echo "Error: $dependency is not installed." >&2
    exit 1
  fi
done

if k3d cluster list | awk -v name="$CLUSTER_NAME" '$1 == name { found = 1 } END { exit !found }'; then
  echo "Using existing cluster $CLUSTER_NAME."
else
  echo "Creating a minimal k3d cluster..."
  k3d cluster create "$CLUSTER_NAME" --servers 1 --agents 0 --no-lb
fi

kubectl config use-context "k3d-$CLUSTER_NAME"
kubectl get nodes
echo "Cluster ready. No application workloads were deployed."
