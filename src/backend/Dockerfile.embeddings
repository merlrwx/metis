FROM python:3.13-slim
COPY --from=ghcr.io/astral-sh/uv:0.12.18 /uv /bin/uv
WORKDIR /app
COPY . /app
RUN uv sync --locked --no-dev --no-editable --extra semantic && useradd --uid 1000 --create-home app && mkdir /models && chown app:app /models
ENV METIS_MODEL_DIR=/models METIS_EMBEDDING_HOST=0.0.0.0
USER app
EXPOSE 8003
CMD ["/app/.venv/bin/metis-embeddings"]
